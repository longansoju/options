# Alpaca paper trading credentials (get from https://app.alpaca.markets/paper-trading)
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# --- Live VPS setup ---
# Market data: 'yfinance' (default, estimates) or 'moomoo' (real, needs OpenD running)
MARKET_DATA_PROVIDER=moomoo
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111
MOOMOO_MARKET=US

# Telegram push (token from @BotFather, chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
